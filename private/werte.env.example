# Vorlage fuer die privaten Werte (echte Domain usw.), die nicht ins oeffentliche Repo gehoeren.
#
# Einrichten:
#   mkdir -p ~/.config/nixos-private && chmod 700 ~/.config/nixos-private
#   cp private/werte.env.example ~/.config/nixos-private/werte.env
#   chmod 600 ~/.config/nixos-private/werte.env   # dann die Werte unten anpassen
#
# Die Datei liest flake.nix als Eingang "private" (path:/home/lmlzr/.config/nixos-private),
# modules/private.nix macht daraus config.nas.private.<NAME>. Nach einer Aenderung:
#   nrs                        (aktualisiert den Eingang selbst)
#   oder: nix flake update private && sudo nixos-rebuild switch --flake .#neotokyo
# Ohne Update baut Nix weiter mit dem alten Stand der Datei.
#
# Format: NAME=Wert, eine Zeile pro Wert, keine Anfuehrungszeichen, # fuer Kommentare.

# Eigene Domain: Pterodactyl-Panel unter https://hosting.<DOMAIN>
DOMAIN=example.com

# Absender fuer Mails ueber Proton (Adresse, fuer die der SMTP-Token erstellt wurde)
MAIL_FROM=service@example.com

# Empfaenger fuer Warnungen (smartd, ZED, fehlgeschlagene Dienste)
MAIL_ALERT_TO=service@example.com
